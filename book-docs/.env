# Backend API Configuration for RAG Chat Widget
# This file is used during local development
# For production builds, set these variables during the CI/CD pipeline or Docker build

# FastAPI RAG Agent backend endpoint
# Used by RAGChatWidget to send queries and receive responses
# Default: http://localhost:8000/ask (local development)
# Production: Set this to your deployed backend URL
REACT_APP_API_URL=http://localhost:8000/ask

# Optional: Disable text selection feature
# REACT_APP_ENABLE_TEXT_SELECTION=false

# Optional: Custom widget position
# REACT_APP_WIDGET_POSITION=bottom-right
